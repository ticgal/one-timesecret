#: front/link.form.php:70
msgid "Secret is missing"
msgstr "Falta el secreto"

#: front/link.form.php:78
msgid "Something wrong happened"
msgstr "Algo ha fallado"

#: front/link.form.php:86
msgid "Please, check the configuration"
msgstr "Por favor, compruebe la configuración"

#: src/Link.php:57
msgid "One-Time Secret"
msgstr "Secreto de un solo uso"

#: src/Secret.php:182
msgid "Hi,"
msgstr "Hola,"

#: src/Secret.php:183
msgid ""
"As mentioned in our previous conversation, this message is meant to share "
"sensitive information with you."
msgstr ""
"Como se mencionó en nuestra conversación anterior, este mensaje está "
"destinado a compartir información confidencial con usted."

#: src/Secret.php:184
msgid ""
"A secret link <b>only works once</b> and <b>then disappears forever</b>. Do "
"not open it if you are not the intended recipient."
msgstr ""
"Este enlace secreto <b>solo funciona una vez</b> y <b>después desaparece "
"para siempre</b>. No lo abra si no es el destinatario."

#: src/Secret.php:185
msgid "Here you have"
msgstr "Aquí tiene"

#: src/Secret.php:186
msgid "your secret link"
msgstr "su enlace secreto"

#: src/Secret.php:189
msgid ""
"I will send you the required passphrase to open it using an alternative "
"method for security reasons."
msgstr ""
"Le enviaré la frase de contraseña requerida para abrirlo usando un método "
"alterno por razones de seguridad."

#: src/Secret.php:191
msgid "Bear in mind:"
msgstr "Tener en cuenta:"

#: src/Secret.php:191
msgid "A secret link can only be opened once and will expire afterwards."
msgstr "El enlace secreto solo se puede abrir una vez y caducará después."

#: src/Secret.php:192
#, php-format
msgid "This secret link will expire %1$s after its generation."
msgstr "Este enlace secreto expirará %1$s después de su generación."

#: src/Secret.php:193
msgid "Regards,"
msgstr "Saludos cordiales,"

#: src/Config.php:189
msgid "Invalid server: use a host name like eu.onetimesecret.com"
msgstr ""

#: src/Profile.php:113
msgid "Display OneTimeSecret button"
msgstr "Mostrar el botón OneTimeSecret"

