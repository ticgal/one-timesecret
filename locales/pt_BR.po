#: front/link.form.php:41
msgid "Secret is missing"
msgstr "Segredo está faltando"

#: front/link.form.php:50
msgid "Something wrong happened"
msgstr "Algo errado aconteceu"

#: front/link.form.php:53
msgid "Please, check the configuration"
msgstr "Por favor, verifique a configuração"

#: inc/profile.class.php:104
msgid "Display OneTimeSecret button"
msgstr "Exibir botão OneTimeSecret"

#: inc/link.class.php:50
msgid "One-Time Secret"
msgstr "Segredo 'One-Time'"

#: inc/secret.class.php:169
msgid "Hi,"
msgstr "Oi,"

#: inc/secret.class.php:169
msgid ""
"As mentioned in our previous conversation, this message is meant to share "
"sensitive information with you."
msgstr ""
"Como mencionado em nossa conversa anterior, esta mensagem tem o objetivo de "
"compartilhar informações confidenciais com você."

#: inc/secret.class.php:170
msgid ""
"A secret link <b>only works once</b> and <b>then disappears forever</b>. Do "
"not open it if you are not the intended recipient."
msgstr ""
"Um link secreto <b>funciona apenas uma vez</b> e <b>então desaparece para "
"sempre</b>. Não o abra se você não é o destinatário correto."

#: inc/secret.class.php:171
msgid "Here you have"
msgstr "Aqui está"

#: inc/secret.class.php:172
msgid "your secret link"
msgstr "seu link secreto"

#: inc/secret.class.php:175
msgid ""
"I will send you the required passphrase to open it using an alternative "
"method for security reasons."
msgstr ""
"Eu vou lhe encaminhar a chave necessária para abrir usando um método "
"alternativo por razões de segurança."

#: inc/secret.class.php:177
msgid "Bear in mind:"
msgstr "Tenha em mente:"

#: inc/secret.class.php:177
msgid "A secret link can only be opened once and will expire afterwards."
msgstr "Um link secreto só pode ser aberto uma vez e expira em seguida."

#: inc/secret.class.php:178
#, php-format
msgid "This secret link will expire %1$s after its generation."
msgstr "Esse link secreto expirará %1$s após sua geração."

#: inc/secret.class.php:179
msgid "Regards,"
msgstr "Saudações,"

#: templates/config.html.twig:76
msgid "API key"
msgstr "Chave API"

#: templates/config.html.twig:88
msgid "Lifetime"
msgstr "Tempo de vida"

#: templates/config.html.twig:96 templates/link.html.twig:58
msgid "Secret lifetime"
msgstr "Vida útil do segredo"

#: templates/link.html.twig:45
msgid "Create a secret"
msgstr "Crie um segredo"

#: templates/link.html.twig:50
msgid "Secret"
msgstr "Segredo"

#: templates/link.html.twig:62
msgid "Optional parameter"
msgstr "Parâmetro opcional"

#: templates/link.html.twig:67
msgid "Passphrase"
msgstr "Chave de segurança"
